# Frontend URLs must be reachable from the browser that uses them.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=motormate-example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=motormate-example
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=motormate-example.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:replace-with-app-id
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=motormate-example
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=motormate-example

FIREBASE_SERVICE_ACCOUNT_FILE=/opt/motormate-secrets/firebase-service-account.json
MOTORMATE_UID=1000
MOTORMATE_GID=1000
